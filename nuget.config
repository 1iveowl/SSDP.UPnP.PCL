<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The local-feed folder source is an interim measure while SimpleHttpListener.Rx 7.x
    and HttpMachine.PCL 6.x complete NuGet validation. Populate it by packing the
    clones under /external (see plan), or remove the source once the packages are
    indexed on nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-feed" value="local-feed" />
  </packageSources>
</configuration>
