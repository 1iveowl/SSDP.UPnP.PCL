<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>1iveowl</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/1iveowl/SSDP.UPnP.PCL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/1iveowl/SSDP.UPnP.PCL</RepositoryUrl>
  </PropertyGroup>

  <!-- Shared by the analyzer, the code fixes and their tests. Version drift
       between the three is a real breakage, so the numbers live in one place. -->
  <PropertyGroup>
    <SsdpAnalyzerTargetFramework>netstandard2.0</SsdpAnalyzerTargetFramework>
    <RoslynVersion>4.8.0</RoslynVersion>
    <RoslynAnalyzersVersion>3.11.0</RoslynAnalyzersVersion>
    <CodeAnalysisTestingVersion>1.1.3</CodeAnalysisTestingVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
